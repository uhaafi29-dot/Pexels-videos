{
  "name": "old-you",
  "version": "1.0.0",
  "description": "The Old You Is Waiting: why you keep returning to old habits. Minimalist 2D narrated reel (Remotion + SVG)",
  "scripts": {
    "studio": "remotion studio",
    "audio": "esbuild scripts/generate-ambient.ts --bundle --platform=node --format=esm --jsx=automatic --log-level=error --outfile=out/generate-ambient.mjs && node out/generate-ambient.mjs",
    "render": "remotion render OldYou out/old-you.mp4",
    "still": "remotion still OldYou out/still.png --frame=300",
    "typecheck": "tsc",
    "captions": "esbuild scripts/export-captions.ts --bundle --platform=node --format=esm --log-level=error --outfile=out/export-captions.mjs && node out/export-captions.mjs",
    "voiceover": "python3 scripts/generate_voiceover.py --model tts/kokoro-q8.onnx --voices tts/voices"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.1.0",
    "@fontsource/inter": "5.1.0",
    "@remotion/cli": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  },
  "private": true
}
